---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WorkAtmosphere from '../../components/works/WorkAtmosphere.astro';
import WorkClosingCta from '../../components/works/WorkClosingCta.astro';
import WorkHero from '../../components/works/WorkHero.astro';
import WorkIntro from '../../components/works/WorkIntro.astro';
import WorkSections from '../../components/works/WorkSections.astro';
import { getWorkPresentation } from '../../utils/workPresentation';
import '../../styles/work-page.css';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const {
  title,
  description,
  image,
  headerImage,
  link,
  inspiredBy,
  summary,
  inspirationStory,
  spotifyPlaylist,
  trailerVideoId,
  experience,
} = work.data;

if (!experience) throw new Error(`Work "${work.id}" is missing experience metadata`);

const presentation = getWorkPresentation(experience);
const pageTitle = `${title} | Siblings Write`;
const permalink = new URL(`/works/${work.id}`, Astro.site).href;
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Our Work', href: '/works' },
  { label: title },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${permalink}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Our Work', item: new URL('/works', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: title, item: permalink },
      ],
    },
    {
      '@type': 'Book',
      '@id': `${permalink}#book`,
      name: title,
      description,
      image: new URL(image, Astro.site).href,
      url: link,
      inLanguage: 'en-US',
      author: {
        '@type': 'Organization',
        name: 'Siblings Write',
        url: new URL('/', Astro.site).href,
      },
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={description}
  permalink={permalink}
  current="works"
  immersiveWork
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <article
    class="work-detail"
    data-work-page
    data-work-id={work.id}
    data-world={experience.world}
    data-atmosphere-active="true"
  >
    <WorkAtmosphere world={experience.world} />
    <WorkHero
      title={title}
      image={headerImage || image}
      trailerVideoId={trailerVideoId}
      cinematicHero={presentation.cinematicHero}
    />
    <div class="work-content">
      <Breadcrumbs items={breadcrumbItems} />
      <WorkIntro
        title={title}
        description={description}
        image={image}
        inspiredBy={inspiredBy}
        amazonUrl={link}
        bookshopUrl={presentation.bookshopUrl}
      />
      <WorkSections
        summary={summary}
        inspirationStory={inspirationStory}
        spotifyPlaylist={spotifyPlaylist}
        quizUrl={presentation.quizUrl}
      />
      <WorkClosingCta amazonUrl={link} bookshopUrl={presentation.bookshopUrl} />
    </div>
  </article>
</BaseLayout>

<script>
  import '../../scripts/work-page';
</script>
