---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bookshelf from '../components/Bookshelf.astro';
import StainedGlassWindow from '../components/library/StainedGlassWindow.astro';
import LibraryTree from '../components/library/LibraryTree.astro';
import Owl from '../components/library/Owl.astro';
import IvyVine from '../components/library/IvyVine.astro';
import CoffeeMug from '../components/library/CoffeeMug.astro';
import Flourish from '../components/library/Flourish.astro';
import { getCollection, getEntry } from 'astro:content';

// Get all works and sort by order
const allWorks = await getCollection('works');
const sortedWorks = allWorks.sort((a, b) => a.data.order - b.data.order);
const featuredWorks = sortedWorks.filter(work => work.data.featured);
const otherWorks = sortedWorks.filter(work => !work.data.featured);

// Get page settings
const worksSettings = await getEntry('pages', 'works');

const title = worksSettings?.data.title || 'Our Work';
const description = worksSettings?.data.description || 'Discover our young adult fiction, middle grade adventures, and Christmas novels. Browse YA fiction like Escape from Browns Island, holiday stories like The Battle for Christmas, and middle grade adventures by the Hawrot siblings.';
const permalink = `${Astro.site.href}work`;
const intro = worksSettings?.data.intro || "We're passionate about creating adventurous stories, that spark your imagination and bring joy to our readers. Here's a look at some of the work we've done and what we're currently working on.";
const featuredTitle = worksSettings?.data.featuredTitle || 'Featured Work';
const otherProjectsTitle = worksSettings?.data.otherProjectsTitle || 'Other Projects';

const testimonials = [
  {
    quote: 'Great story. I love the descriptions of the store and the people. It was heart warming.♥️',
    source: 'Reader of our Short Stories',
  },
  {
    quote: "Escape from Brown's Island bursts off the page like a star running back on a Saturday-night breakaway—fast, thrilling, and impossible to stop. The Hawrot siblings cut, juke, and power through danger with the perfect mix of grit and finesse, turning every chapter into a game-winning drive. A true end-zone celebration of adventure worthy of the record books.",
    source: "Reader of Escape from Brown's Island",
  },
  {
    quote: "I decided to give this book a try over the holiday season and I'm so glad I did! This was a huge break from the normal self-help / non-fiction books I like to read, so I wasn't sure what to expect. The authors do a wonderful job of building a world based on their own lives while pushing into fantasy and adventure in so many creative ways! I couldn't put the book down after the halfway point where the story keeps you guessing while filling you with an undeniable Christmas cheer. I'm a grown adult who felt like a kid again while enjoying this story. I've since passed it along to my own son with the same joy shared by the characters in this book! I hope you enjoy it as much as we do!",
    source: 'Reader of Battle for Christmas: Reign of the Nutcrackers',
  },
];

// Dust motes drifting through the lamplight. Seeded so builds stay identical.
let moteSeed = 424242;
const moteRnd = () => {
  moteSeed = (moteSeed * 1103515245 + 12345) % 2147483648;
  return moteSeed / 2147483648;
};
const motes = Array.from({ length: 18 }, () => ({
  left: (moteRnd() * 100).toFixed(2),
  top: (18 + moteRnd() * 72).toFixed(2),
  size: (2 + moteRnd() * 4).toFixed(1),
  drift: (moteRnd() * 60 - 30).toFixed(0),
  delay: (moteRnd() * 18).toFixed(2),
  duration: (16 + moteRnd() * 16).toFixed(2),
  opacity: (0.28 + moteRnd() * 0.5).toFixed(2),
}));

// Generate structured data for all works
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.siblingswrite.com/works#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.siblingswrite.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Our Work",
          "item": "https://www.siblingswrite.com/works"
        }
      ]
    },
    ...featuredWorks.map(work => ({
      "@type": "Book",
      "@id": `https://www.siblingswrite.com/work#${work.id}`,
      "name": work.data.title,
      "description": work.data.description,
      "image": `https://www.siblingswrite.com${work.data.image}`,
      "url": work.data.link,
      "inLanguage": "en-US"
    }))
  ]
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="work">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="library">
    <!-- ─── The room itself ──────────────────────────────────────── -->
    <div class="room" aria-hidden="true">
      <div class="room-lintel">
        <div class="room-lintel-ivy"><IvyVine width={1200} amplitude={22} tone="deep" /></div>
      </div>

      <div class="room-tree">
        <LibraryTree />
        <div class="perch perch--one"><Owl variant="warm" delay={0} /></div>
        <div class="perch perch--two"><Owl variant="cool" delay={2.4} /></div>
      </div>

      <div class="room-ivy room-ivy--left"><IvyVine width={900} amplitude={30} tone="bright" /></div>
      <div class="room-ivy room-ivy--right"><IvyVine width={900} amplitude={30} tone="bright" /></div>

      <div class="room-motes">
        {motes.map((m) => (
          <span
            class="mote"
            style={`left:${m.left}%;top:${m.top}%;width:${m.size}px;height:${m.size}px;--mote-drift:${m.drift}px;--mote-delay:${m.delay}s;--mote-duration:${m.duration}s;--mote-opacity:${m.opacity}`}
          ></span>
        ))}
      </div>

      <div class="room-floor"></div>
    </div>

    <!-- ─── Content ──────────────────────────────────────────────── -->
    <div class="room-inner">
      <header class="threshold">
        <div class="threshold-crown">
          <p class="threshold-eyebrow">Mind the ivy &middot; the lights are always on</p>
          <h1 class="threshold-title">{title}</h1>
          <Flourish type="divider" class="threshold-rule" />
        </div>
        <div class="plaque">
          <span class="plaque-corner plaque-corner--tl"><Flourish type="corner" /></span>
          <span class="plaque-corner plaque-corner--tr"><Flourish type="corner" /></span>
          <span class="plaque-corner plaque-corner--bl"><Flourish type="corner" /></span>
          <span class="plaque-corner plaque-corner--br"><Flourish type="corner" /></span>
          <p class="threshold-intro">{intro}</p>
        </div>
      </header>

      <!-- Interactive Bookshelf -->
      <section class="alcove" aria-labelledby="alcove-heading">
        <div class="lamp" aria-hidden="true"></div>
        <h2 id="alcove-heading" class="engraved">{featuredTitle}</h2>
        <p class="section-lead">Run your finger along the spines. Tug one loose and it opens.</p>
        <div class="alcove-stage">
          <div class="alcove-window alcove-window--left">
            <StainedGlassWindow variant="dawn" />
          </div>
          <div class="alcove-frame">
            <Bookshelf />
          </div>
          <div class="alcove-window alcove-window--right">
            <StainedGlassWindow variant="dusk" />
          </div>
        </div>
      </section>

      <!-- Every book, up close -->
      {featuredWorks.length > 0 && (
        <section class="catalog" aria-labelledby="catalog-heading">
          <h2 id="catalog-heading" class="engraved">The Card Catalog</h2>
          <p class="section-lead">Every book on the shelf, lit up and waiting in its own little alcove.</p>

          <div class="tomes">
            {featuredWorks.map((work) => (
              <article class="tome" itemscope itemtype="https://schema.org/Book">
                <span class="tome-corner tome-corner--tl" aria-hidden="true"><Flourish type="corner" /></span>
                <span class="tome-corner tome-corner--tr" aria-hidden="true"><Flourish type="corner" /></span>
                <span class="tome-corner tome-corner--bl" aria-hidden="true"><Flourish type="corner" /></span>
                <span class="tome-corner tome-corner--br" aria-hidden="true"><Flourish type="corner" /></span>

                <a href={`/works/${work.id}`} class="tome-niche" tabindex="-1" aria-hidden="true">
                  <span class="tome-niche-light"></span>
                  <img
                    src={work.data.image}
                    alt=""
                    width="168"
                    height="252"
                    itemprop="image"
                    loading="lazy"
                  />
                </a>

                <div class="tome-text">
                  <h3 class="tome-title" itemprop="name">
                    <a href={`/works/${work.id}`}>{work.data.title}</a>
                  </h3>
                  <p class="tome-desc" itemprop="description">{work.data.description}</p>
                  {work.data.inspiredBy && (
                    <p class="tome-whisper">
                      <span class="tome-whisper-label">Where it came from</span>
                      {work.data.inspiredBy}
                    </p>
                  )}
                  <div class="tome-actions">
                    <a href={`/works/${work.id}`} class="btn btn--brass">
                      Learn More
                      <span class="sr-only"> about {work.data.title}</span>
                    </a>
                    <a
                      href={work.data.link}
                      target="_blank"
                      rel="noopener"
                      class="btn btn--seal"
                      itemprop="url"
                    >
                      Buy on Amazon
                      <span class="sr-only"> — {work.data.title}</span>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {otherWorks.length > 0 && (
        <section class="catalog catalog--other" aria-labelledby="other-heading">
          <h2 id="other-heading" class="engraved">{otherProjectsTitle}</h2>
          <p class="section-lead">Still drying on the desk.</p>
          <div class="tomes tomes--compact">
            {otherWorks.map((work) => (
              <article class="tome tome--compact">
                <a href={`/works/${work.id}`} class="tome-niche" tabindex="-1" aria-hidden="true">
                  <span class="tome-niche-light"></span>
                  <img src={work.data.image} alt="" width="140" height="210" loading="lazy" />
                </a>
                <div class="tome-text">
                  <h3 class="tome-title"><a href={`/works/${work.id}`}>{work.data.title}</a></h3>
                  <p class="tome-desc">{work.data.description}</p>
                  <div class="tome-actions">
                    <a href={`/works/${work.id}`} class="btn btn--brass">Learn More</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- Reader Testimonials -->
      <section class="nook" aria-labelledby="nook-heading">
        <div class="nook-mug" aria-hidden="true"><CoffeeMug /></div>
        <h2 id="nook-heading" class="engraved">What Readers Are Saying</h2>
        <p class="section-lead">Take the good chair by the window. These notes were left by readers.</p>

        <div class="nook-vine" aria-hidden="true"><IvyVine width={1500} amplitude={16} tone="deep" /></div>

        <div class="quotes">
          {testimonials.map((t) => (
            <figure class="quote">
              <span class="quote-corner quote-corner--tl" aria-hidden="true"><Flourish type="corner" /></span>
              <span class="quote-corner quote-corner--tr" aria-hidden="true"><Flourish type="corner" /></span>
              <span class="quote-corner quote-corner--bl" aria-hidden="true"><Flourish type="corner" /></span>
              <span class="quote-corner quote-corner--br" aria-hidden="true"><Flourish type="corner" /></span>
              <span class="quote-medallion" aria-hidden="true">&#10078;</span>
              <blockquote class="quote-body"><p>{t.quote}</p></blockquote>
              <figcaption class="quote-source">{t.source}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════════════
     THE LIBRARY
     A warmer, dimmer room built from the site's own violets, roses
     and teals so it reads as a doorway rather than a different site.
     ═══════════════════════════════════════════════════════════════ */

  .library {
    --ink: #33223f;
    --ink-soft: #5d4a5c;
    --parchment: #fdf6e9;
    --parchment-2: #f7ead4;
    --parchment-3: #edd9bb;
    --gold: #b98327;
    --gold-light: #e6c173;
    --gold-deep: #8a5f18;
    --plum: #43305a;
    --plum-deep: #281a3b;
    --violet: #7c3aed;
    --rose: #e4738f;
    --teal: #4f9a92;
    --ivy: #3b6b3c;
    --wood: #6b4a22;
    --lamp: #ffd88a;

    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: -1em;
    padding: 0 0 4rem;
    overflow: hidden;
    isolation: isolate;
    color: var(--ink);
    font-family: var(--font-family-serif);

    background:
      radial-gradient(140% 64% at 50% -6%, rgba(28, 17, 44, 0.98) 0%, rgba(41, 26, 60, 0.88) 20%, rgba(60, 41, 80, 0.42) 44%, rgba(60, 41, 80, 0) 64%),
      radial-gradient(80% 44% at 50% 30%, rgba(255, 205, 130, 0.46), transparent 76%),
      radial-gradient(50% 34% at 3% 62%, rgba(198, 124, 92, 0.18), transparent 74%),
      radial-gradient(50% 34% at 97% 62%, rgba(124, 58, 237, 0.14), transparent 74%),
      linear-gradient(180deg, #e2d2b8 0%, #efe1c6 28%, #f5e9d3 50%, #efdec2 72%, #e2cba7 88%, #d0b58f 100%);
  }

  /* Panelled wall and a brass threshold where the room ends */
  .library::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 14px;
    background: linear-gradient(180deg, #d4a93a 0%, #a87c22 30%, #7a5510 68%, #3d2508 100%);
    box-shadow: 0 -8px 22px rgba(26, 14, 4, 0.5), inset 0 1px 0 rgba(255, 240, 200, 0.45);
    z-index: 2;
  }

  .room::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      90deg,
      transparent 0 156px,
      rgba(88, 58, 28, 0.055) 156px 158px,
      transparent 158px 162px
    );
    opacity: 0.75;
  }

  /* Corners of the room fall into shadow */
  .room::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(46, 28, 62, 0.4) 0%,
      rgba(46, 28, 62, 0.1) 12%,
      rgba(46, 28, 62, 0) 24%,
      rgba(46, 28, 62, 0) 76%,
      rgba(46, 28, 62, 0.1) 88%,
      rgba(46, 28, 62, 0.4) 100%
    );
  }

  /* ─── Ambience layers ──────────────────────────────────────────── */
  .room {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  /* Doorway beam you step under */
  .room-lintel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 54px;
    background:
      linear-gradient(180deg, #4d3317 0%, #6b4a22 34%, #56391a 72%, #33200c 100%);
    box-shadow:
      0 10px 28px rgba(20, 10, 2, 0.6),
      inset 0 2px 0 rgba(255, 225, 175, 0.22),
      inset 0 -3px 0 rgba(0, 0, 0, 0.45);
  }

  .room-lintel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      90deg,
      transparent 0 70px,
      rgba(255, 232, 190, 0.05) 70px 72px,
      transparent 72px 158px,
      rgba(0, 0, 0, 0.08) 158px 161px
    );
  }

  .room-lintel-ivy {
    position: absolute;
    top: 22px;
    left: 0;
    right: 0;
    overflow: hidden;
  }

  /* Reading tree */
  .room-tree {
    position: absolute;
    top: 34px;
    left: -70px;
    width: calc(100% + 140px);
    min-width: 1080px;
    opacity: 0.98;
  }

  .perch {
    position: absolute;
  }

  .perch--one {
    left: 15.5%;
    top: 19.8%;
    width: 9.5%;
  }

  .perch--two {
    left: 64.6%;
    top: 18%;
    width: 7.5%;
  }

  /* Ivy climbing the side walls */
  .room-ivy {
    position: absolute;
    top: 54%;
    width: 920px;
    height: 94px;
    margin-top: -47px;
    opacity: 0.85;
  }

  .room-ivy--left {
    left: -404px;
    transform: rotate(-90deg);
  }

  .room-ivy--right {
    right: -404px;
    transform: rotate(90deg);
  }

  /* Dust in the lamplight */
  .room-motes {
    position: absolute;
    inset: 0;
  }

  .mote {
    position: absolute;
    border-radius: 50%;
    background: #fff3d4;
    opacity: var(--mote-opacity, 0.4);
    box-shadow: 0 0 8px 2px rgba(255, 226, 166, 0.5);
    animation: mote-drift var(--mote-duration, 22s) ease-in-out var(--mote-delay, 0s) infinite;
  }

  @keyframes mote-drift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(var(--mote-drift, 20px), -46px); }
  }

  /* Floorboards */
  .room-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 210px;
    background:
      linear-gradient(180deg, rgba(122, 82, 44, 0) 0%, rgba(122, 82, 44, 0.18) 20%, rgba(96, 62, 30, 0.44) 62%, rgba(62, 38, 16, 0.7) 100%),
      repeating-linear-gradient(90deg, rgba(60, 36, 14, 0.11) 0 2px, transparent 2px 108px);
  }

  /* Baseboard where the wall meets the floor */
  .room-floor::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 26px;
    height: 16px;
    background: linear-gradient(180deg, #7a5a30 0%, #5d4222 55%, #3c2812 100%);
    box-shadow: 0 6px 16px rgba(30, 16, 4, 0.35), inset 0 1px 0 rgba(255, 228, 178, 0.28);
  }

  /* ─── Content column ──────────────────────────────────────────── */
  .room-inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ─── Threshold (page header) ──────────────────────────────────── */
  .threshold {
    /* Enough headroom that the heading always clears the canopy and the
       owl sitting in it, at every width. */
    padding-top: clamp(5.5rem, 24vw, 13rem);
    text-align: center;
  }

  /* A pool of shade behind the heading so it stays readable wherever the
     lights happen to fall in the canopy. */
  .threshold-crown {
    position: relative;
    padding: 1.2rem 1rem 0.2rem;
  }

  .threshold-crown::before {
    content: '';
    position: absolute;
    inset: -14% -8%;
    background: radial-gradient(
      56% 62% at 50% 46%,
      rgba(26, 15, 40, 0.8) 0%,
      rgba(26, 15, 40, 0.52) 46%,
      rgba(26, 15, 40, 0) 78%
    );
    z-index: -1;
    pointer-events: none;
  }

  .threshold-eyebrow {
    font-family: var(--font-family-storybook);
    font-size: clamp(0.66rem, 1.5vw, 0.82rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #f2d9a4;
    margin: 0 0 0.9rem;
    text-shadow: 0 0 18px rgba(255, 206, 130, 0.6);
  }

  .threshold-title {
    font-family: var(--font-family-storybook);
    font-size: clamp(2.3rem, 7vw, 4.4rem);
    line-height: 1.05;
    margin: 0;
    color: #fdf3df;
    text-shadow:
      0 0 28px rgba(255, 205, 128, 0.5),
      0 3px 0 rgba(70, 44, 12, 0.5),
      0 14px 30px rgba(24, 12, 32, 0.55);
  }

  .threshold-rule {
    margin: 1.4rem auto 2rem;
    filter: drop-shadow(0 0 10px rgba(255, 206, 130, 0.4));
  }

  /* Parchment plaque */
  .plaque {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(1.6rem, 4vw, 2.4rem) clamp(1.5rem, 4vw, 3rem);
    background:
      linear-gradient(180deg, rgba(255, 252, 243, 0.97) 0%, rgba(247, 234, 212, 0.97) 100%);
    border: 1px solid rgba(185, 131, 39, 0.55);
    border-radius: 4px;
    box-shadow:
      0 26px 50px rgba(38, 22, 12, 0.3),
      inset 0 0 0 1px rgba(255, 255, 255, 0.6),
      inset 0 0 40px rgba(185, 131, 39, 0.08);
  }

  .plaque::after {
    content: '';
    position: absolute;
    inset: 7px;
    border: 1px solid rgba(185, 131, 39, 0.35);
    border-radius: 2px;
    pointer-events: none;
  }

  .plaque-corner {
    position: absolute;
    width: 34px;
    height: 34px;
    opacity: 0.85;
    pointer-events: none;
  }

  .plaque-corner--tl { top: 5px; left: 5px; }
  .plaque-corner--tr { top: 5px; right: 5px; transform: scaleX(-1); }
  .plaque-corner--bl { bottom: 5px; left: 5px; transform: scaleY(-1); }
  .plaque-corner--br { bottom: 5px; right: 5px; transform: scale(-1); }

  .threshold-intro {
    position: relative;
    margin: 0;
    font-size: clamp(1rem, 2.2vw, 1.16rem);
    line-height: 1.8;
    color: var(--ink);
  }

  .threshold-intro::first-letter {
    font-family: var(--font-family-storybook);
    font-size: 3.1em;
    float: left;
    line-height: 0.82;
    padding: 0.08em 0.12em 0 0;
    color: var(--gold-deep);
    text-shadow: 0 2px 0 rgba(255, 255, 255, 0.7);
  }

  /* ─── Engraved section headings ───────────────────────────────── */
  .engraved {
    font-family: var(--font-family-storybook);
    font-size: clamp(1.3rem, 3.4vw, 1.95rem);
    text-align: center;
    color: #f6e4bd;
    margin: 0;
    letter-spacing: 0.03em;
    text-shadow:
      0 0 22px rgba(255, 206, 130, 0.35),
      0 2px 0 rgba(60, 38, 10, 0.45);
  }

  .section-lead {
    text-align: center;
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    font-style: italic;
    color: #e8d3ae;
    margin: 0.6rem auto 2rem;
    max-width: 44ch;
  }

  /* Lower sections sit on parchment, so their type darkens */
  .catalog .engraved,
  .nook .engraved {
    color: #46306a;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .catalog .section-lead,
  .nook .section-lead {
    color: var(--ink-soft);
  }

  /* ─── Bookshelf alcove ────────────────────────────────────────── */
  .alcove {
    position: relative;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .lamp {
    position: absolute;
    top: -90px;
    left: 50%;
    width: min(760px, 86%);
    height: 260px;
    transform: translateX(-50%);
