---
/** One discoverable archive glyph on the reading tree. */
---

<button
  type="button"
  class="tree-archive-glyph"
  data-tree-secret
  aria-expanded="false"
  aria-controls="tree-archive-panel"
  aria-label="Carved library sigil — reveal hidden archive notes"
>
  ✶
</button>

<div id="tree-archive-panel" class="tree-archive-panel" data-tree-secret-panel hidden>
  <p class="tree-archive-lead">Concealed archive — for readers who notice the tree.</p>
</div>
