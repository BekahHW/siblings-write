---
/**
 * A cozy mug for the reading nook. Steam drifts; the cocoa never goes cold.
 */
export interface Props {
  class?: string;
  withBook?: boolean;
}

const { class: className = '', withBook = true } = Astro.props;
---

<svg
  class={`mug ${className}`}
  viewBox="0 0 200 170"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="mug-glaze" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#cfd9e8" />
      <stop offset="18%" stop-color="#fbfdff" />
      <stop offset="62%" stop-color="#e6eaf3" />
      <stop offset="100%" stop-color="#b9c3d4" />
    </linearGradient>
    <linearGradient id="mug-brew" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#7a4a26" />
      <stop offset="100%" stop-color="#4a2a13" />
    </linearGradient>
    <linearGradient id="mug-book" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#7c3aed" />
      <stop offset="100%" stop-color="#5b2ab0" />
    </linearGradient>
  </defs>

  <!-- Steam -->
  <g class="mug-steam" fill="none" stroke="#e9dcc7" stroke-width="4.5" stroke-linecap="round">
    <path class="wisp wisp-1" d="M78,62 C68,48 86,40 76,24 C70,15 78,8 84,4" opacity="0.75" />
    <path class="wisp wisp-2" d="M100,58 C90,42 108,34 98,18 C93,10 100,4 106,0" opacity="0.6" />
    <path class="wisp wisp-3" d="M120,64 C112,50 128,42 120,28 C115,20 121,13 126,9" opacity="0.5" />
  </g>

  {withBook && (
    <g>
      <path d="M2,150 L2,128 L56,120 L56,146 Z" fill="url(#mug-book)" />
      <path d="M56,120 L56,146 L60,146 L60,119 Z" fill="#3f1d80" />
      <path d="M6,146 L6,127 L52,121 L52,143 Z" fill="#f6ecd8" opacity="0.9" />
      <path d="M10,140 L46,135 M10,134 L44,129" stroke="#c9b79a" stroke-width="1.6" />
    </g>
  )}

  <!-- Saucer -->
  <ellipse cx="102" cy="152" rx="62" ry="12" fill="#c9b79a" />
  <ellipse cx="102" cy="149" rx="62" ry="12" fill="#e6d7ba" />
  <ellipse cx="102" cy="149" rx="40" ry="7" fill="#cdbb9c" opacity="0.6" />

  <!-- Handle -->
  <path
    d="M148,92 C176,88 178,124 150,124"
    fill="none"
    stroke="#d7dde9"
    stroke-width="13"
    stroke-linecap="round"
  />
  <path
    d="M148,92 C176,88 178,124 150,124"
    fill="none"
    stroke="#fafcff"
    stroke-width="4"
    stroke-linecap="round"
    opacity="0.7"
  />

  <!-- Mug body -->
  <path d="M58,80 L148,80 L141,140 C140,146 134,148 103,148 C72,148 66,146 65,140 Z" fill="url(#mug-glaze)" />
  <path d="M74,88 L80,140" stroke="#fff" stroke-width="5" opacity="0.55" stroke-linecap="round" />

  <!-- Rim and brew -->
  <ellipse cx="103" cy="80" rx="45" ry="11" fill="#f4f7fc" />
  <ellipse cx="103" cy="80" rx="38" ry="8.4" fill="url(#mug-brew)" />
  <path d="M92,79 C96,74 102,74 103,79 C104,74 110,74 114,79 C110,85 104,87 103,84 C102,87 96,85 92,79 Z" fill="#e8d5b7" opacity="0.85" />

  <!-- Painted band -->
  <path d="M63,108 C78,113 128,113 143,108" fill="none" stroke="#7c3aed" stroke-width="3.4" opacity="0.55" />
  <circle cx="87" cy="120" r="3" fill="#e4738f" opacity="0.7" />
  <circle cx="103" cy="123" r="3" fill="#d9a43a" opacity="0.7" />
  <circle cx="119" cy="120" r="3" fill="#4f9a92" opacity="0.7" />
</svg>

<style>
  .mug {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 18px rgba(60, 36, 16, 0.28));
  }

  .wisp {
    transform-box: fill-box;
    transform-origin: bottom center;
  }

  .wisp-1 { animation: steam 5.4s ease-in-out infinite; }
  .wisp-2 { animation: steam 6.6s ease-in-out 0.8s infinite; }
  .wisp-3 { animation: steam 5.9s ease-in-out 1.6s infinite; }

  @keyframes steam {
    0%, 100% { opacity: 0.25; transform: translateY(4px) scaleY(0.9) skewX(0deg); }
    40% { opacity: 0.8; transform: translateY(-4px) scaleY(1.08) skewX(5deg); }
    70% { opacity: 0.45; transform: translateY(-9px) scaleY(1.14) skewX(-4deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wisp-1,
    .wisp-2,
    .wisp-3 {
      animation: none;
      opacity: 0.5;
    }
  }
</style>
