---
/**
 * A stoneware mug going cold next to a book. Soft gradients and shadow
 * rather than outlines, so it sits in the room instead of on top of it.
 */
export interface Props {
  class?: string;
  withBook?: boolean;
}

const { class: className = '', withBook = true } = Astro.props;
---

<svg
  class={`mug ${className}`}
  viewBox="0 0 200 170"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="mug-glaze" x1="0" y1="0" x2="1" y2="0.2">
      <stop offset="0%" stop-color="#4a3d38" />
      <stop offset="14%" stop-color="#8d7d72" />
      <stop offset="40%" stop-color="#b9a898" />
      <stop offset="72%" stop-color="#7e6f64" />
      <stop offset="100%" stop-color="#3d332e" />
    </linearGradient>
    <linearGradient id="mug-brew" x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0%" stop-color="#5c3418" />
      <stop offset="70%" stop-color="#33190a" />
      <stop offset="100%" stop-color="#241107" />
    </linearGradient>
    <linearGradient id="mug-saucer" x1="0" y1="0" x2="1" y2="0.4">
      <stop offset="0%" stop-color="#6d5c50" />
      <stop offset="42%" stop-color="#a4907f" />
      <stop offset="100%" stop-color="#4e413a" />
    </linearGradient>
    <linearGradient id="mug-book" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#3f2a5c" />
      <stop offset="100%" stop-color="#241538" />
    </linearGradient>
    <radialGradient id="mug-shadow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#18100a" stop-opacity="0.5" />
      <stop offset="100%" stop-color="#18100a" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Contact shadow on the table -->
  <ellipse cx="104" cy="156" rx="86" ry="15" fill="url(#mug-shadow)" />

  <!-- Steam -->
  <g class="mug-steam" fill="none" stroke="#e4d6bc" stroke-width="3.4" stroke-linecap="round">
    <path class="wisp wisp-1" d="M80,62 C71,48 87,41 78,26 C72,17 79,10 85,6" opacity="0.5" />
    <path class="wisp wisp-2" d="M101,58 C92,43 109,35 100,20 C95,12 101,6 107,2" opacity="0.4" />
    <path class="wisp wisp-3" d="M121,64 C113,50 128,43 121,29 C116,21 122,14 127,10" opacity="0.32" />
  </g>

  {withBook && (
    <g>
      <path d="M2,150 L2,128 L56,120 L56,146 Z" fill="url(#mug-book)" />
      <path d="M56,120 L56,146 L60,146 L60,119 Z" fill="#170d24" />
      <path d="M6,146 L6,127 L52,121 L52,143 Z" fill="#c9b89a" />
      <path d="M6,146 L6,127 L52,121 L52,143 Z" fill="#2a1c10" opacity="0.35" />
      <path d="M10,140 L46,135 M10,134 L44,129" stroke="#8d7a5d" stroke-width="1.4" />
    </g>
  )}

  <!-- Saucer -->
  <ellipse cx="102" cy="151" rx="61" ry="11.5" fill="#2d251f" />
  <ellipse cx="102" cy="148" rx="61" ry="11.5" fill="url(#mug-saucer)" />
  <ellipse cx="102" cy="148" rx="41" ry="7" fill="#3a2f28" opacity="0.55" />

  <!-- Handle -->
  <path d="M147,92 C175,88 177,124 149,124" fill="none" stroke="#4a3d36" stroke-width="14" stroke-linecap="round" />
  <path d="M147,92 C173,89 175,122 149,122" fill="none" stroke="#a08d7e" stroke-width="5" stroke-linecap="round" opacity="0.7" />

  <!-- Body -->
  <path d="M58,80 L148,80 L141,140 C140,146 134,148 103,148 C72,148 66,146 65,140 Z" fill="url(#mug-glaze)" />
  <path d="M73,88 C71,108 73,126 79,140" stroke="#e2d4c4" stroke-width="4" opacity="0.32" fill="none" stroke-linecap="round" />
  <path d="M132,88 C134,108 132,126 127,140" stroke="#1d1712" stroke-width="6" opacity="0.4" fill="none" stroke-linecap="round" />

  <!-- Rim and brew -->
  <ellipse cx="103" cy="80" rx="45" ry="10.5" fill="#c4b1a0" />
  <ellipse cx="103" cy="81" rx="45" ry="10.5" fill="#6f6058" opacity="0.5" />
  <ellipse cx="103" cy="80" rx="38" ry="8.4" fill="url(#mug-brew)" />
  <ellipse cx="96" cy="78" rx="14" ry="3.4" fill="#c08a4d" opacity="0.3" />

  <!-- Glaze catching the lamp -->
  <ellipse cx="88" cy="96" rx="7" ry="18" fill="#fff6e4" opacity="0.16" />
</svg>

<style>
  .mug {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 12px 20px rgba(30, 18, 8, 0.42));
  }

  .wisp {
    transform-box: fill-box;
    transform-origin: bottom center;
  }

  .wisp-1 { animation: steam 7.4s ease-in-out infinite; }
  .wisp-2 { animation: steam 8.8s ease-in-out 1.2s infinite; }
  .wisp-3 { animation: steam 8s ease-in-out 2.4s infinite; }

  @keyframes steam {
    0%, 100% { opacity: 0.12; transform: translateY(5px) scaleY(0.88) skewX(0deg); }
    40% { opacity: 0.5; transform: translateY(-4px) scaleY(1.1) skewX(6deg); }
    70% { opacity: 0.24; transform: translateY(-11px) scaleY(1.18) skewX(-5deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wisp-1,
    .wisp-2,
    .wisp-3 {
      animation: none;
      opacity: 0.3;
    }
  }
</style>
