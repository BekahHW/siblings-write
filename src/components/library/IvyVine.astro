---
/**
 * A trailing ivy vine. Leaves and tendrils are generated along a sine stem so
 * the growth looks hand-drawn rather than tiled.
 */
export interface Props {
  width?: number;
  amplitude?: number;
  wavelength?: number;
  tone?: 'deep' | 'bright';
  class?: string;
}

const {
  width = 1200,
  amplitude = 26,
  wavelength = 300,
  tone = 'deep',
  class: className = '',
} = Astro.props;

let seed = 777 + width + Math.round(amplitude);
const rnd = () => {
  seed = (seed * 1103515245 + 12345) % 2147483648;
  return seed / 2147483648;
};

const tones = {
  deep: { stem: '#24381f', leaves: ['#16301d', '#1c3b24', '#21452a', '#122816'], vein: '#4d6f45' },
  bright: { stem: '#2d4726', leaves: ['#1e4026', '#26502e', '#2e5c34', '#17331c'], vein: '#5d8352' },
};
const t = tones[tone];

const samples = 240;

// Two harmonics rather than one, so the stem meanders instead of repeating.
const strand = (phase: number, amp: number, drop: number) =>
  Array.from({ length: samples + 1 }, (_, i) => {
    const x = (i / samples) * width;
    const y =
      amplitude +
      drop +
      amp * Math.sin((x / wavelength) * Math.PI * 2 + phase) +
      amp * 0.42 * Math.sin((x / (wavelength * 0.37)) * Math.PI * 2 + phase * 1.7);
    return [x, y] as [number, number];
  });

const strands = [strand(0, amplitude, 0), strand(2.1, amplitude * 0.74, amplitude * 0.32)];

const stemPaths = strands.map(
  (pts) => `M${pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' L')}`
);

const leafShape =
  'M0,0 L0.5,-5 C-5,-4 -11,-7 -9.5,-12 C-14,-13.5 -14,-20 -8.5,-21 C-7.5,-27 -1.5,-28 0,-23 C1.5,-28 7.5,-27 8.5,-21 C14,-20 14,-13.5 9.5,-12 C11,-7 5,-4 -0.5,-5 Z';

const decorations: {
  kind: 'leaf' | 'tendril';
  x: number;
  y: number;
  rot: number;
  scale: number;
  fill: string;
  delay: number;
}[] = [];

strands.forEach((points, strandIndex) => {
for (let i = 5; i < samples; i += 5) {
  const [x, y] = points[i];
  const [px, py] = points[i - 2];
  const [nx, ny] = points[i + 2] ?? points[i];
  const angle = (Math.atan2(ny - py, nx - px) * 180) / Math.PI;
  const side = (i / 5) % 2 === 0 ? -1 : 1;

  if (rnd() > 0.86) {
    decorations.push({
      kind: 'tendril',
      x,
      y,
      rot: angle + side * (54 + rnd() * 40),
      scale: 0.7 + rnd() * 0.5,
      fill: t.stem,
      delay: rnd() * 6,
    });
    continue;
  }

  // Two or three leaves per node, fanned and overlapping at different
  // sizes, which is what stops a vine looking like a decal.
  const fan = rnd() > 0.45 ? 3 : 2;
  for (let k = 0; k < fan; k += 1) {
    decorations.push({
      kind: 'leaf',
      x: x + (rnd() - 0.5) * 9,
      y: y + (rnd() - 0.5) * 7,
      rot: angle + side * (40 + rnd() * 70) + (k - 1) * (16 + rnd() * 14),
      scale: 0.5 + rnd() * 0.95,
      fill: t.leaves[Math.floor(rnd() * t.leaves.length)],
      delay: rnd() * 6,
    });
  }
}
});
---

<svg
  class={`ivy ${className}`}
  viewBox={`0 -34 ${width} 122`}
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  {stemPaths.map((d) => (
    <>
      <path d={d} fill="none" stroke={t.stem} stroke-width="3" stroke-linecap="round" />
      <path d={d} fill="none" stroke="rgba(255,228,176,0.1)" stroke-width="0.9" />
    </>
  ))}

  {decorations.map((d) => (
    <g
      class="ivy-leaf"
      transform={`translate(${d.x.toFixed(1)} ${d.y.toFixed(1)}) rotate(${d.rot.toFixed(1)}) scale(${d.scale.toFixed(2)})`}
      style={`--leaf-delay:${d.delay.toFixed(2)}s`}
    >
      {d.kind === 'leaf' ? (
        <>
          <path d={leafShape} fill={d.fill} />
          <path d="M0,-4 L0,-21" stroke={t.vein} stroke-width="0.9" opacity="0.35" fill="none" />
          <path d="M0,-11 L-5,-16 M0,-11 L5,-16" stroke={t.vein} stroke-width="0.7" opacity="0.25" fill="none" />
        </>
      ) : (
        <path
          d="M0,0 C5,-5 12,-2 10,4 C8.6,8.4 2,8 0.6,3.6"
          fill="none"
          stroke={t.stem}
          stroke-width="2"
          stroke-linecap="round"
        />
      )}
    </g>
  ))}
</svg>

<style>
  .ivy {
    display: block;
    width: 100%;
    min-width: 760px;
    height: auto;
  }

  .ivy-leaf {
    transform-box: fill-box;
    animation: leaf-stir 7s ease-in-out var(--leaf-delay, 0s) infinite;
  }

  @keyframes leaf-stir {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ivy-leaf {
      animation: none;
    }
  }
</style>
