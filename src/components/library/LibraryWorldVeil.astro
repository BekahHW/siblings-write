---
/** Decorative atmosphere layers toggled by `.library[data-world]`. */
---

<div class="world-veil" aria-hidden="true" data-animated>
  <div class="world-layer world-layer--valley-glow"></div>
  <div class="world-layer world-layer--fireflies">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="world-layer world-layer--paw"></div>
  <div class="world-layer world-layer--snow">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="world-layer world-layer--nutcracker-shadow"></div>
  <div class="world-layer world-layer--fog"></div>
  <div class="world-layer world-layer--water-shimmer"></div>
  <div class="world-layer world-layer--coast-light"></div>
  <div class="world-layer world-layer--caustics"></div>
  <div class="world-layer world-layer--sand-drift"></div>
</div>
