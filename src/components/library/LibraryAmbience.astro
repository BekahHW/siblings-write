---
import type { LibraryMote } from '../../utils/generateMotes';
import IvyVine from './IvyVine.astro';
import LibraryTree from './LibraryTree.astro';
import Owl from './Owl.astro';

interface Props {
  motes: LibraryMote[];
}

const { motes } = Astro.props;
---

<div class="room" aria-hidden="true">
  <div class="room-lintel">
    <div class="room-lintel-ivy"><IvyVine width={1200} amplitude={22} tone="deep" /></div>
  </div>

  <div class="room-tree" data-animated>
    <LibraryTree />
    <div class="perch perch--one"><Owl variant="warm" delay={0} /></div>
    <div class="perch perch--two"><Owl variant="cool" delay={2.4} /></div>
  </div>

  <div class="room-ivy room-ivy--left"><IvyVine width={900} amplitude={30} tone="bright" /></div>
  <div class="room-ivy room-ivy--right"><IvyVine width={900} amplitude={30} tone="bright" /></div>

  <div class="room-motes" data-animated>
    {motes.map((mote) => (
      <span
        class="mote"
        style={`left:${mote.left}%;top:${mote.top}%;width:${mote.size}px;height:${mote.size}px;--mote-drift:${mote.drift}px;--mote-delay:${mote.delay}s;--mote-duration:${mote.duration}s;--mote-opacity:${mote.opacity}`}
      ></span>
    ))}
  </div>

  <div class="room-grain"></div>
  <div class="room-floor"></div>
</div>
