---
import '../../styles/library-worlds.css';
---

<div class="library-atmosphere" aria-hidden="true" data-animated data-atmosphere>
  <div class="world-layer world-layer--valley" data-world-layer="valley" aria-hidden="true">
    <span class="world-detail world-detail--valley"></span>
  </div>
  <div class="world-layer world-layer--christmas" data-world-layer="christmas" aria-hidden="true">
    <span class="world-detail world-detail--christmas"></span>
  </div>
  <div class="world-layer world-layer--island" data-world-layer="island" aria-hidden="true">
    <span class="world-detail world-detail--island"></span>
  </div>
  <div class="world-layer world-layer--sandbridge" data-world-layer="sandbridge" aria-hidden="true">
    <span class="world-detail world-detail--sandbridge"></span>
  </div>
  <span class="rare-leaf"></span>
</div>
