---
import WorkPurchaseActions from './WorkPurchaseActions.astro';

interface Props {
  workId: string;
  title: string;
  description: string;
  image: string;
  inspiredBy?: string;
  amazonUrl: string;
  bookshopUrl?: string;
}

const { workId, title, description, image, inspiredBy, amazonUrl, bookshopUrl } = Astro.props;
---

<section class="work-intro" aria-label={`${title} introduction`}>
  <div class="work-cover-wrap">
    <img
      src={image}
      alt={`${title} book cover`}
      class="work-cover"
      loading="eager"
      transition:name={`story-cover-${workId}`}
    />
  </div>
  <div class="work-intro-copy">
    <p class="work-logline">{description}</p>
    {inspiredBy && (
      <aside class="work-inspired">
        <p class="eyebrow">What Inspired This Story</p>
        <p>{inspiredBy}</p>
      </aside>
    )}
    <WorkPurchaseActions amazonUrl={amazonUrl} bookshopUrl={bookshopUrl} />
  </div>
</section>
