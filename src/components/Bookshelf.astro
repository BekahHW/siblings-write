---
/**
 * The shelf. Each spine is a tab: selecting one opens the matching spread
 * in the reader below it.
 */
export interface Props {
  books: { id: string; title: string; image: string }[];
  activeId?: string;
  heading?: string;
}

const { books, activeId = books[0]?.id, heading = 'Our books' } = Astro.props;
---

<section class="bookshelf-section" aria-labelledby="bookshelf-heading">
  <h2 id="bookshelf-heading" class="sr-only">{heading}</h2>

  <div class="shelf-unit">
    <!--
      Two-layer structure:
      .shelf-back-panel  → dark background, no overflow (avoids vertical clip)
      .shelf-scroll      → horizontal scroll only
    -->
    <div class="shelf-back-panel">
      <div class="shelf-scroll">
        <div class="books-row" role="tablist" aria-label={heading} data-shelf>
          {books.map((book) => (
            <button
              type="button"
              class="book-card"
              role="tab"
              id={`shelf-tab-${book.id}`}
              aria-controls={`spread-${book.id}`}
              aria-selected={book.id === activeId ? 'true' : 'false'}
              tabindex={book.id === activeId ? 0 : -1}
              data-book={book.id}
            >
              <img
                class="book-cover-img"
                src={book.image}
                alt={book.title}
                loading="lazy"
                width="160"
                height="240"
              />
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Wooden shelf plank -->
    <div class="shelf-board" aria-hidden="true">
      <div class="shelf-board-edge"></div>
    </div>
  </div>
</section>

<style>
  /* ─── Accessibility ─────────────────────────────────────────────── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ─── Section ──────────────────────────────────────────────────── */
  .bookshelf-section {
    margin: 2.5em 0 3em;
  }

  /* ─── Dark back panel — NO overflow property ───────────────────── */
  /*
    Critical: this element must NOT set overflow.
    overflow-x:auto implies overflow-y:auto per CSS spec, which would
    clip the vertical dimension and cut off book bottoms.
  */
  .shelf-back-panel {
    background: linear-gradient(180deg, #120a04 0%, #1e1008 45%, #2a1a0c 100%);
    border-radius: 10px 10px 0 0;
    box-shadow: inset 0 0 100px rgba(0, 0, 0, 0.5);
  }

  /* ─── Scroll wrapper — handles horizontal overflow only ─────────── */
  .shelf-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 40px 40px 0;
  }

  .shelf-scroll::-webkit-scrollbar {
    display: none;
  }

  /* ─── Books row ────────────────────────────────────────────────── */
  .books-row {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ─── Book card ────────────────────────────────────────────────── */
  .book-card {
    display: block;
    position: relative;
    flex-shrink: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    border-radius: 4px 6px 6px 4px;
    overflow: hidden;

    box-shadow:
      6px 8px 20px rgba(0, 0, 0, 0.7),
      -3px 0 8px rgba(0, 0, 0, 0.4),
      inset 4px 0 14px rgba(0, 0, 0, 0.25);

    transition:
      transform 0.38s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.32s ease;
    transform-origin: center bottom;
  }

  /* Spine binding shadow */
  .book-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 12px;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.15) 65%,
      transparent 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  /* Hover/focus — "picking up" the book */
  .book-card:hover,
  .book-card:focus-visible {
    transform: translateY(-24px) scale(1.09);
    box-shadow:
      10px 30px 60px rgba(0, 0, 0, 0.8),
      0 14px 28px rgba(0, 0, 0, 0.5),
      inset 4px 0 14px rgba(0, 0, 0, 0.25);
    z-index: 10;
    outline: none;
  }

  .book-card:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.85);
    outline-offset: 4px;
  }

  /* The book currently open in the reader stays off the shelf */
  .book-card[aria-selected='true'] {
    transform: translateY(-18px) scale(1.06);
    box-shadow:
      10px 26px 52px rgba(0, 0, 0, 0.78),
      0 0 34px rgba(255, 196, 116, 0.42),
      inset 4px 0 14px rgba(0, 0, 0, 0.25);
    z-index: 5;
  }

  .book-card[aria-selected='true']:hover,
  .book-card[aria-selected='true']:focus-visible {
    transform: translateY(-26px) scale(1.09);
  }

  /* ─── Cover image ──────────────────────────────────────────────── */
  .book-cover-img {
    display: block;
    width: 160px;
    height: 240px;
    object-fit: cover;
    object-position: center top;
  }

  /* ─── Wooden shelf board ───────────────────────────────────────── */
  .shelf-board {
    height: 28px;
    background: linear-gradient(
      180deg,
      #d4a93a 0%,
      #a87c22 22%,
      #8b6215 48%,
      #7a5510 72%,
      #4e3209 100%
    );
    box-shadow:
      0 12px 35px rgba(0, 0, 0, 0.75),
      0 4px 12px rgba(0, 0, 0, 0.5),
      inset 0 2px 0 rgba(255, 255, 255, 0.18),
      inset 0 -2px 0 rgba(0, 0, 0, 0.45);
    border-radius: 0 0 10px 10px;
    position: relative;
    overflow: hidden;
  }

  /* Wood grain */
  .shelf-board::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      90deg,
      transparent 0px,
      transparent 80px,
      rgba(255, 255, 255, 0.04) 80px,
      rgba(255, 255, 255, 0.04) 82px,
      transparent 82px,
      transparent 180px,
      rgba(0, 0, 0, 0.06) 180px,
      rgba(0, 0, 0, 0.06) 183px
    );
  }

  .shelf-board-edge {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 9px;
    background: rgba(0, 0, 0, 0.38);
    border-radius: 0 0 10px 10px;
  }

  /* ─── Reduced motion ───────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .book-card {
      transition: box-shadow 0.2s ease;
    }

    .book-card:hover,
    .book-card:focus-visible {
      transform: translateY(-8px) scale(1.03);
    }

    .book-card[aria-selected='true'] {
      transform: translateY(-6px) scale(1.02);
    }
  }

  /* ─── Mobile ───────────────────────────────────────────────────── */
  @media (max-width: 700px) {
    .shelf-scroll {
      padding: 28px 24px 0;
      scroll-snap-type: x mandatory;
    }

    .books-row {
      justify-content: flex-start;
      gap: 20px;
    }

    .book-card {
      scroll-snap-align: center;
    }

    .book-cover-img {
      width: 140px;
      height: 210px;
    }
  }

  @media (max-width: 440px) {
    .shelf-scroll {
      padding: 24px 16px 0;
    }

    .book-cover-img {
      width: 124px;
      height: 186px;
    }
  }
</style>
